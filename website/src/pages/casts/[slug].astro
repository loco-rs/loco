---
// English cast page at /casts/<slug>/ — from the `casts` collection.
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import CastPost from '../../components/CastPost.astro';
import type { Locale } from '../../lib/i18n';

export async function getStaticPaths() {
  const casts = await getCollection('casts');
  return casts.map((cast: CollectionEntry<'casts'>) => ({
    params: { slug: cast.id },
    props: { cast, locale: 'en' as Locale },
  }));
}

const { cast, locale } = Astro.props as {
  cast: CollectionEntry<'casts'>;
  locale: Locale;
};
---

<CastPost cast={cast} locale={locale} />
