---
// Ported from the reference `<footer>` block (markup + styles), see
// docs/superpowers/specs/2026-07-17-homepage-direction-a-reference.html.
import { t, localizedPath, type Locale } from '../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const tr = t(locale);
---

<footer>
  <div class="wrap">
    <span>{tr('footer.tagline')}</span>
    <nav aria-label="Footer">
      <a href={localizedPath('/docs/', locale)}>{tr('footer.docs')}</a><span aria-hidden="true">·</span>
      <a href="https://github.com/loco-rs/loco" target="_blank" rel="noopener noreferrer">{tr('footer.github')}</a><span aria-hidden="true">·</span>
      <a href="https://discord.gg/fTvyBzwKS8" target="_blank" rel="noopener noreferrer">{tr('footer.discord')}</a><span aria-hidden="true">·</span>
      <a href={localizedPath('/blog/', locale)}>{tr('footer.blog')}</a>
    </nav>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    margin-top: 44px;
    padding: 40px 0;
    color: var(--ink-2);
    font-size: 13.5px;
    display: flex;
    justify-content: space-between;
  }
  .wrap {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 32px;
    width: 100%;
    display: flex;
    justify-content: space-between;
  }
  nav {
    display: flex;
    gap: 0.5rem;
  }
  nav a:hover {
    color: var(--ink);
  }
  @media (max-width: 640px) {
    .wrap {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
