---
// The casts (screencasts) listing — under Base+Nav+Footer like the blog
// index, ordered by episode ascending (episode 001 first). `episode` is a
// zero-padded string ("001".."007"), so a plain string comparison already
// sorts numerically for this width — parsed to a number anyway to be robust
// if episode count ever crosses a digit boundary (e.g. "099" vs "100").
//
// Locale parameterized: /casts/ (English) and /uk/casts/ share this markup;
// episode titles/notes stay English, the chrome follows the page locale.
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import CastCard from './CastCard.astro';
import { t, type Locale } from '../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const tr = t(locale);
type Cast = CollectionEntry<'casts'>;

const casts = (await getCollection(locale === 'uk' ? 'castsUk' : 'casts'))
  .map((c) => c as Cast)
  .sort((a, b) => Number(a.data.episode) - Number(b.data.episode));
---

<Base
  title={`${tr('nav.casts')} — Loco`}
  description={locale === 'uk'
    ? 'Короткі скринкасти про можливості Loco — по епізоду за раз.'
    : 'Short screencasts walking through Loco features, one episode at a time.'}
  locale={locale}
>
  <Nav locale={locale} />
  <section class="casts-index">
    <div class="wrap">
      <div class="head">
        <h1>{tr('nav.casts')}</h1>
        <p>{locale === 'uk'
          ? 'Короткі, сфокусовані огляди можливостей Loco — подивіться епізод, прочитайте нотатки.'
          : 'Short, focused walkthroughs of Loco features — watch the episode, read the notes.'}</p>
      </div>
      <div class="grid">
        {casts.map((cast) => <CastCard cast={cast} locale={locale} />)}
      </div>
    </div>
  </section>
  <Footer locale={locale} />
</Base>
<style>
  .wrap {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 32px;
    width: 100%;
  }
  section.casts-index {
    padding: 64px 0 40px;
  }
  .head {
    max-width: 60ch;
    margin-bottom: 48px;
  }
  .head h1 {
    font-size: 44px;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--ink);
  }
  .head p {
    margin-top: 14px;
    font-size: 17px;
    color: var(--ink-2);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  @media (max-width: 980px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
