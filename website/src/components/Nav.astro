---
// Ported verbatim from the reference `<nav>` block (markup + styles), see
// docs/superpowers/specs/2026-07-17-homepage-direction-a-reference.html.
import ThemeToggle from './ThemeToggle.astro';
---

<nav>
  <div class="wrap">
    <div class="brand"><img src="/loco-mark.svg" alt="Loco" /> loco</div>
    <div class="navlinks">
      <a href="/docs/">Docs</a><a href="/blog/">Blog</a><a href="/casts/">Screencasts</a>
    </div>
    <div class="navright">
      <span class="stars">★ 6.9k</span>
      <ThemeToggle />
      <a class="btn btn-primary" href="#">Get started</a>
    </div>
  </div>
</nav>

<style>
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0;
    position: sticky;
    top: 0;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
    z-index: 20;
  }
  .wrap {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 32px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .brand img {
    width: 30px;
    height: 30px;
    display: block;
  }
  .navlinks {
    display: flex;
    gap: 28px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--ink-2);
  }
  .navlinks a:hover {
    color: var(--ink);
  }
  .navright {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .stars {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink-2);
    border: 1px solid var(--line);
    padding: 7px 12px;
    border-radius: 9px;
    background: var(--card);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 650;
    font-size: 14.5px;
    padding: 10px 18px;
    border-radius: 10px;
    transition: 0.15s;
    cursor: pointer;
    border: none;
    font-family: inherit;
  }
  .btn-primary {
    background: var(--red);
    color: #fff;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.06), 0 8px 20px -8px rgba(252, 56, 32, 0.55);
  }
  .btn-primary:hover {
    background: var(--red-ink);
    transform: translateY(-1px);
  }
  /* ThemeToggle.astro (Task 2) renders a bare `<button class="toggle">` with
     no styles of its own — the reference's `.toggle` rule is nav-owned. */
  :global(nav .toggle) {
    width: 36px;
    height: 36px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: var(--card);
    cursor: pointer;
    font-size: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
  }
  @media (max-width: 900px) {
    .navlinks {
      display: none;
    }
  }
</style>
