---
// An author's page — name, bio (rendered markdown body via `render`), and
// the list of their blog posts as PostCards. Shared by /authors/<slug>/ and
// /uk/authors/<slug>/ (the caller supplies the author from the right
// collection).
//
// Only authors with an entry in the `authors` collection get a page here —
// slugs referenced by posts but with no author file (e.g. `antonio-souza`
// on deploy-aws.md) never get one. That matches the blog byline, which
// renders those as plain, unlinked text for the same reason.
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import ProseArticle from './ProseArticle.astro';
import PostCard from './PostCard.astro';
import { t, type Locale } from '../lib/i18n';

interface Props {
  author: CollectionEntry<'authors'>;
  locale: Locale;
}

const { author, locale } = Astro.props;
const tr = t(locale);
const { Content } = await render(author);

const posts = ((await getCollection(locale === 'uk' ? 'blogUk' : 'blog')) as CollectionEntry<'blog'>[])
  .filter((post) => post.data.authors.includes(author.id))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const postsHeading = locale === 'uk' ? 'Дописи' : 'Posts';
const emptyPosts = locale === 'uk' ? 'Покищо немає дописів.' : 'No posts yet.';
---

<Base
  title={`${author.data.name} — ${tr('nav.blog')}`}
  description={author.data.description}
  locale={locale}
>
  <Nav locale={locale} />
  <article class="author">
    <div class="wrap">
      <div class="author-head">
        <h1>{author.data.name}</h1>
        <ProseArticle>
          <Content />
        </ProseArticle>
      </div>
      <div class="posts">
        <h2>{postsHeading}</h2>
        {
          posts.length > 0 ? (
            <div class="grid">
              {posts.map((post) => <PostCard post={post} locale={locale} />)}
            </div>
          ) : (
            <p class="empty">{emptyPosts}</p>
          )
        }
      </div>
    </div>
  </article>
  <Footer locale={locale} />
</Base>

<style>
  .wrap {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 32px;
    width: 100%;
  }
  article.author {
    padding: 64px 0 80px;
  }
  .author-head {
    max-width: 68ch;
    margin: 0 auto 56px;
  }
  .author-head h1 {
    font-size: 40px;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--ink);
    margin-bottom: 24px;
  }
  .posts {
    max-width: 1160px;
    margin: 0 auto;
  }
  .posts h2 {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 24px;
  }
  .posts .empty {
    font-size: 15px;
    color: var(--ink-3);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  @media (max-width: 640px) {
    .author-head h1 {
      font-size: 30px;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
