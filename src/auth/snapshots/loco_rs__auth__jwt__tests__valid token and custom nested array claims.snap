---
source: src/auth/jwt.rs
expression: jwt.validate(&token)
---
Ok(
    TokenData {
        header: Header {
            typ: Some(
                "JWT",
            ),
            alg: HS512,
        },
        claims: UserClaims {
            pid: "pid",
            exp: EXP,
            claims: {
                "level1": Object {
                    "level2": Object {
                        "level3": Array [
                            Number(1),
                            Number(2),
                            Number(3),
                        ],
                    },
                },
            },
        },
    },
)
