---
source: src/auth/jwt.rs
expression: jwt.validate(&token)
---
Ok(
    TokenData {
        header: Header {
            typ: Some(
                "JWT",
            ),
            alg: HS512,
        },
        claims: UserClaims {
            pid: "pid",
            exp: EXP,
            claims: {},
        },
    },
)
