---
source: loco-gen/tests/templates/oauth.rs
expression: "read(&tree, \"config/production.yaml\")"
---
server:
  port: 5150

# Authentication Configuration
auth:
  session:
    # Signs the session cookie. Production reads it from SESSION_SECRET;
    # generate one with `openssl rand -base64 64`.
    secret: <%= get_env(name="SESSION_SECRET") %>
  # OAuth sign-in (`cargo loco generate oauth <provider>`)
  oauth:
    providers:
      github:
        client_id: <%= get_env(name="GITHUB_CLIENT_ID") %>
        client_secret: <%= get_env(name="GITHUB_CLIENT_SECRET") %>
